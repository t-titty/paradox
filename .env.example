# === Database ===
# Used by Prisma + server. docker-compose brings up a postgres matching these creds.
DATABASE_URL="postgresql://paradox:paradox@localhost:5432/paradox?schema=public"
POSTGRES_USER=paradox
POSTGRES_PASSWORD=paradox
POSTGRES_DB=paradox

# === Server ===
PORT=4000
NODE_ENV=development
# 32+ chars. Regenerate in prod.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === Anthropic (The Oracle) ===
# Required for Phase III (The Sort) and future Phase IV fallacy detection.
ANTHROPIC_API_KEY=sk-ant
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Phase timing (24h clock, local server time) ===
# Override for demos: set PHASE_OVERRIDE to drop|vow|sort|duel|bridge to force a phase.
PHASE_DROP_HOUR=8
PHASE_VOW_END_HOUR=12
PHASE_SORT_END_HOUR=20
PHASE_OVERRIDE=

# === Phase V ===
# Flashback surfaces old votes. Real cadence is 180 days; override lower for demos.
FLASHBACK_MIN_DAYS=180
# Civility score at or below this routes users into the Echo Chamber pool.
ECHO_CHAMBER_THRESHOLD=40

# === Client ===
VITE_API_BASE_URL=http://localhost:4000
