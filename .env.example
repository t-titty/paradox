# === Database ===
# Used by Prisma + server. docker-compose brings up a postgres matching these creds.
DATABASE_URL="postgresql://paradox:paradox@localhost:5432/paradox?schema=public"
POSTGRES_USER=paradox
POSTGRES_PASSWORD=paradox
POSTGRES_DB=paradox

# === Server ===
PORT=4000
NODE_ENV=development
# 32+ chars. Regenerate in prod.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === Anthropic (The Oracle) ===
# Required for Phase III (The Sort) and future Phase IV fallacy detection.
ANTHROPIC_API_KEY=sk-ant
ANTHROPIC_MODEL=claude-sonnet-4-6
# Small, fast model for the per-message Crucible checks (runs on every duel
# message). ORACLE_FAST_EFFORT="" omits the effort parameter.
ORACLE_FAST_MODEL=claude-haiku-5-5
ORACLE_FAST_EFFORT=low
# Model for the AI sparring partner. Blank = ANTHROPIC_MODEL.
SPAR_MODEL=

# === Phase timing (24h clock, on the game clock below) ===
# Everyone plays on one shared clock in this IANA zone, wherever the server runs.
PHASE_TIMEZONE=America/New_York
# Let players who missed the Vow window still vote (and duel) until midnight.
ALLOW_LATE_VOWS=true
# Override for demos: set PHASE_OVERRIDE to drop|vow|sort|duel|bridge to force a phase.
PHASE_DROP_HOUR=8
PHASE_VOW_END_HOUR=12
PHASE_SORT_END_HOUR=20
PHASE_OVERRIDE=

# === Phase V ===
# Flashback surfaces old votes. Real cadence is 180 days; override lower for demos.
FLASHBACK_MIN_DAYS=180
# Civility score at or below this routes users into the Echo Chamber pool.
ECHO_CHAMBER_THRESHOLD=40

# === Stripe ===
# Server-side secret + webhook signing secret. Leave blank in dev to disable
# the /api/stripe/* endpoints (they'll 503 until a key is present).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used by Checkout success/cancel URLs to redirect back to the client origin.
PUBLIC_APP_URL=http://localhost:5173

# === Client ===
VITE_API_BASE_URL=http://localhost:4000
# Public publishable key — reserved for future client-side Stripe UI. Hosted
# Checkout (current flow) doesn't require it.
VITE_STRIPE_PUBLISHABLE_KEY=
