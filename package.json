{
  "name": "paradox",
  "private": true,
  "version": "0.1.0",
  "description": "PARADOX \u2014 daily ethical dilemma debate platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start:prod",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:reset": "npm --workspace server run db:reset"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
