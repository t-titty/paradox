// PARADOX schema. All tables in the spec live here — Phase IV/V tables
// (duels, synthesis_archive, tribe_history) are declared now so next
// session's work can migrate cleanly from this baseline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tribe {
  Utilitarian
  Deontologist
  VirtueEthicist
  Nihilist
  Stoic
  Existentialist
  Hedonist
}

enum Choice {
  A
  B
}

enum SubmittedParadoxStatus {
  pending
  approved
  rejected
}

enum CircleType {
  JUNIOR_HIGH
  HIGH_SCHOOL
  UNIVERSITY
  CORPORATE
  // Friend & family Dens — lightweight personal circles. Share the Circle
  // table but render a simplified dashboard on the client.
  DEN
}

enum MembershipRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ParadoxPackage {
  STANDARD
  JUNIOR_HIGH
  HIGH_SCHOOL
  UNIVERSITY
  CORPORATE
}

// Lifecycle of a live Colosseum party session.
enum PartySessionStatus {
  LOBBY
  VOTING
  REVEAL
  ENDED
}

// Which kind of one-time (non-subscription) product a purchase represents.
// Kept as a small enum rather than free-form strings so TypeScript can
// exhaustively handle new product classes as we add them.
enum OneTimeProduct {
  PARTY_PRO_LIFETIME
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  hashedPassword String
  wisdomPoints   Int      @default(0)
  civilityScore  Int      @default(100)
  isPremium      Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  isBanned       Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  // Admin-granted bypass for the Circle creation paywall. Paid subscribers
  // are gated via Circle.subscriptionStatus instead.
  isGrantedCircleAccess Boolean @default(false)
  // Admin-granted per-user test mode. Unlocks phase switching, date-check
  // bypass, and the test-mode banner for this user only. Combined with the
  // system-wide env.TEST_MODE by `effectiveTestMode` (OR). Invisible to
  // regular users — the toggle lives in the admin Developer panel.
  testMode       Boolean  @default(false)
  createdAt      DateTime @default(now())

  votes            Vote[]
  tribeHistory     TribeHistory[]
  duelsAsA         Duel[]         @relation("DuelUserA")
  duelsAsB         Duel[]         @relation("DuelUserB")
  throwbackRevotes ThrowbackRevote[]
  feedback         Feedback[]
  submittedParadoxes SubmittedParadox[]
  authoredParadoxes  Paradox[]          @relation("ParadoxSubmitter")
  ownedCircles       Circle[]           @relation("CircleOwner")
  circleMemberships  CircleMembership[]
  inviteCodesCreated CircleInviteCode[] @relation("InviteCreator")

  partySessionsHosted PartySession[]      @relation("PartySessionHost")
  partyVotes          PartyVote[]
  partyPlayers        PartyPlayer[]
  oneTimePurchases    OneTimePurchase[]
  partyPackPurchases  PartyPackPurchase[]

  passwordResetTokens PasswordResetToken[]
}

// Single-use password reset tokens. The token column is a random hex string
// (crypto.randomBytes(32).toString("hex")) stored plainly — the value is
// already high-entropy and the row expires in an hour; we treat it like a
// session token, not a password. `usedAt` flips on successful reset so
// replay fails. Cascade on user delete keeps the table clean.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Paradox {
  id          String   @id @default(cuid())
  title       String
  description String
  optionA     String
  optionB     String
  category    String
  // Each paradox airs on exactly one date. Null = not yet scheduled.
  airDate     DateTime? @unique @db.Date
  createdAt   DateTime  @default(now())
  // Null for seed/editorial paradoxes; populated when an admin approves
  // a user-submitted dilemma. Nulling the user would orphan their credit
  // rather than deleting the paradox, so onDelete:SetNull.
  submittedById String?
  submittedBy   User?    @relation("ParadoxSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  votes            Vote[]
  duels            Duel[]
  tribeHistory     TribeHistory[]
  throwbackRevotes ThrowbackRevote[]
  partySessions    PartySession[]

  @@index([submittedById])
}

model Vote {
  id            String   @id @default(cuid())
  userId        String
  paradoxId     String
  choice        Choice
  justification String
  // Populated by Phase III. Null until Oracle has sorted.
  tribeAssigned Tribe?
  tribeConfidence Float?
  tribeReasoning String?
  createdAt     DateTime @default(now())
  sortedAt      DateTime?
  // Scopes a vote to a private circle game. Null = global/public game.
  // Runtime routing by circle game is not wired yet — see Circles rollout notes.
  circleGameId  String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paradox    Paradox     @relation(fields: [paradoxId], references: [id], onDelete: Cascade)
  circleGame CircleGame? @relation(fields: [circleGameId], references: [id], onDelete: SetNull)

  throwbackRevote ThrowbackRevote?

  @@unique([userId, paradoxId])
  @@index([paradoxId, choice])
  @@index([paradoxId, tribeAssigned])
  @@index([circleGameId])
}

// Thursday revisits. Every Thursday, eligible users revote a prior
// Thursday paradox (≥28 days old). Original Vote stays untouched; the
// revisit lives here so both points in time are preserved.
model ThrowbackRevote {
  id               String   @id @default(cuid())
  userId           String
  originalVoteId   String   @unique
  paradoxId        String
  newChoice        Choice
  newJustification String
  // "shifted" | "held" | "evolved" — see lib/throwback.ts
  shift            String
  createdAt        DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalVote Vote    @relation(fields: [originalVoteId], references: [id], onDelete: Cascade)
  paradox      Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Denormalized tribe history for fast profile queries + Moral Constellation.
// One row per (user, paradox) — duplicates Vote.tribeAssigned but indexed for
// timeline scans.
model TribeHistory {
  id        String   @id @default(cuid())
  userId    String
  paradoxId String
  tribe     Tribe
  airDate   DateTime @db.Date
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paradox Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)

  @@unique([userId, paradoxId])
  @@index([userId, airDate])
}

// Phase IV — populated next session. Declared now so migrations stay additive.
model Duel {
  id                   String   @id @default(cuid())
  paradoxId            String
  userAId              String
  userBId              String
  transcriptJson       Json     @default("[]")
  synthesisText        String?
  synthesisGeneratedAt DateTime?
  signedByAAt          DateTime?
  signedByBAt          DateTime?
  declinedAt           DateTime?
  bothSigned           Boolean  @default(false)
  startedAt            DateTime @default(now())
  endedAt              DateTime?
  // Scopes a duel to a private circle game. Null = global/public game.
  circleGameId         String?

  paradox    Paradox     @relation(fields: [paradoxId], references: [id])
  userA      User        @relation("DuelUserA", fields: [userAId], references: [id])
  userB      User        @relation("DuelUserB", fields: [userBId], references: [id])
  circleGame CircleGame? @relation(fields: [circleGameId], references: [id], onDelete: SetNull)

  archive SynthesisArchive?

  @@index([paradoxId])
  @@index([bothSigned])
  @@index([circleGameId])
}

// Minimal stub for the Private Circles application form. Stored so ops has
// a record to follow up on; no admin UI yet.
model CircleApplication {
  id           String   @id @default(cuid())
  organization String
  kind         String   // "JUNIOR_HIGH" | "HIGH_SCHOOL" | "UNIVERSITY" | "COMPANY"
  contactEmail String
  note         String?
  submittedByUserId String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// User-submitted feedback (bug reports, feature requests, general notes).
// Visible to admins in the admin panel.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   // "bug" | "feature" | "general"
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// User-submitted paradox proposals. Admins approve/reject in the admin panel.
// On approval, a Paradox is created and scheduled to the next free airDate.
model SubmittedParadox {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  optionA     String
  optionB     String
  category    String
  reason      String
  status      SubmittedParadoxStatus @default(pending)
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  scheduledFor DateTime? @db.Date
  paradoxId   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Phase V — public archive of signed syntheses.
model SynthesisArchive {
  id            String   @id @default(cuid())
  duelId        String   @unique
  paradoxTitle  String
  tribeA        Tribe
  tribeB        Tribe
  synthesisText String
  signedAt      DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([signedAt])
}

// Private Circles — closed instances for schools, universities, and companies.
// A Circle holds one or more CircleGames (e.g. "Period 1 Class"). Membership
// is per-Circle, not per-Game — members are invited into a Circle and can
// participate in any Game within it. Stripe fields (customerId, subscriptionId,
// seatLimit, billingPeriod, currentPeriodEnd) will be added in the Stripe pass.
model Circle {
  id                 String   @id @default(cuid())
  name               String
  type               CircleType
  ownerId            String
  // Stripe lifecycle. "trial" (or "pending") until the checkout.session.completed
  // webhook flips it to "active". "past_due" on invoice.payment_failed;
  // "canceled" on subscription.deleted.
  subscriptionStatus String   @default("trial")
  stripeCustomerId      String?
  stripeSubscriptionId  String?  @unique
  // Stable key from the server pricing catalogue, e.g. JR_HIGH_STANDARD_MONTHLY.
  // Lets us render the plan name + intent without round-tripping Stripe.
  stripePriceLookupKey  String?
  // "monthly" | "6month" | "annual". Mirrors the catalogue billing choice.
  billingPeriod         String?
  // Null = unlimited (CORPORATE_ENTERPRISE tier).
  seatLimit             Int?
  currentPeriodEnd      DateTime?
  // Reserved for per-Circle defaults (e.g. default schedule overrides).
  settings           Json     @default("{}")
  createdAt          DateTime @default(now())

  owner       User               @relation("CircleOwner", fields: [ownerId], references: [id])
  memberships CircleMembership[]
  games       CircleGame[]

  @@index([ownerId])
  @@index([stripeCustomerId])
}

model CircleMembership {
  id       String         @id @default(cuid())
  circleId String
  userId   String
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// One daily loop inside a Circle. Multiple Games per Circle lets a teacher
// run separate classes on separate paradoxes. Per-game schedule fields are
// stored now but runtime resolution is still global — wired in a later pass.
model CircleGame {
  id             String         @id @default(cuid())
  circleId       String
  name           String
  description    String?
  paradoxPackage ParadoxPackage @default(STANDARD)
  dropHour       Int            @default(8)
  vowEndHour     Int            @default(12)
  sortEndHour    Int            @default(20)
  duelHour       Int            @default(20)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  circle      Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviteCodes CircleInviteCode[]
  votes       Vote[]
  duels       Duel[]

  @@index([circleId])
}

// Short, shareable codes that consume into a CircleMembership on the parent
// Circle. A code belongs to a Game so the join confirmation can show which
// class/department the user is joining.
model CircleInviteCode {
  id           String    @id @default(cuid())
  circleGameId String
  code         String    @unique
  uses         Int       @default(0)
  maxUses      Int?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  createdById  String

  circleGame CircleGame @relation(fields: [circleGameId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([circleGameId])
}

// Age/role-targeted dilemma packs. STANDARD is intentionally not stored here
// (Games with package=STANDARD draw from the global Paradox table). The
// paradoxes column is a JSON array of { title, description, optionA, optionB,
// category } objects — light-weight, non-normalized since packs are content,
// not user data.
model CircleParadoxPack {
  id        String         @id @default(cuid())
  package   ParadoxPackage @unique
  paradoxes Json
  updatedAt DateTime       @updatedAt
}

// ---------- Colosseum (Party Mode) ------------------------------------
// Live, in-person party game. Distinct from the daily PARADOX loop — a
// session is ephemeral (hours, not weeks), keyed on a short roomCode rather
// than a membership, and spans a single paradox with its own vote set.
// Votes are NOT written back to the main Vote table — the whole session is
// a separate audience-driven experience — but the party history is queryable
// per-user for profile display.
model PartySession {
  id        String             @id @default(cuid())
  hostId    String
  // 6-char uppercase code shown on the cast screen and entered at /join.
  // Globally unique for the lifetime of the row; expired codes stay
  // reserved so replays and share links remain unambiguous.
  roomCode  String             @unique
  // Chosen by the host after lobby. Null while status=LOBBY.
  paradoxId String?
  status    PartySessionStatus @default(LOBBY)
  createdAt DateTime           @default(now())
  endedAt   DateTime?

  host    User        @relation("PartySessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  paradox Paradox?    @relation(fields: [paradoxId], references: [id], onDelete: SetNull)
  votes   PartyVote[]
  players PartyPlayer[]

  @@index([hostId, createdAt])
  @@index([status])
}

model PartyVote {
  id            String   @id @default(cuid())
  sessionId     String
  userId        String
  choice        Choice
  justification String
  createdAt     DateTime @default(now())

  session PartySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model PartyPlayer {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  // Party-specific alias shown on screen; distinct from User.username so
  // players can use a fun name for a single night without touching their
  // profile.
  displayName String
  joinedAt    DateTime @default(now())

  session PartySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// ---------- One-time purchases ----------------------------------------
// Flat audit table for non-subscription purchases (lifetime unlocks, etc.).
// We keep Stripe's chargeId *and* paymentIntentId so refunds can be
// reconciled either way, and so repeated webhook deliveries for the same
// PI are idempotent via the unique stripePaymentIntentId.
model OneTimePurchase {
  id                    String         @id @default(cuid())
  userId                String
  product               OneTimeProduct
  stripeChargeId        String?
  stripePaymentIntentId String?        @unique
  amountCents           Int
  currency              String         @default("usd")
  createdAt             DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can own a given product at most once. If they double-purchase,
  // the webhook ignores the second on this conflict.
  @@unique([userId, product])
  @@index([userId])
}

// Party pack content unlocks, one row per (user, pack). Kept separate from
// OneTimePurchase because packs are a high-cardinality content catalogue
// keyed by slug, whereas OneTimeProduct is a low-cardinality enum.
model PartyPackPurchase {
  id                    String   @id @default(cuid())
  userId                String
  // Free-form slug keyed to the server pack catalogue (e.g. "HOLIDAY",
  // "DATE_NIGHT"). String rather than enum so adding packs doesn't require
  // a schema migration.
  packSlug              String
  stripeChargeId        String?
  stripePaymentIntentId String?  @unique
  amountCents           Int
  currency              String   @default("usd")
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packSlug])
  @@index([userId])
}
