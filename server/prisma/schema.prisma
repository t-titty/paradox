// PARADOX schema. All tables in the spec live here — Phase IV/V tables
// (duels, synthesis_archive, tribe_history) are declared now so next
// session's work can migrate cleanly from this baseline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tribe {
  Utilitarian
  Deontologist
  VirtueEthicist
  Nihilist
  Stoic
  Existentialist
  Hedonist
}

enum Choice {
  A
  B
}

enum SubmittedParadoxStatus {
  pending
  approved
  rejected
}

enum CircleType {
  JUNIOR_HIGH
  HIGH_SCHOOL
  UNIVERSITY
  CORPORATE
  // Friend & family Dens — lightweight personal circles sharing the Circle
  // table. Rendered with a simplified dashboard on the client.
  DEN
}

enum MembershipRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ParadoxPackage {
  STANDARD
  JUNIOR_HIGH
  HIGH_SCHOOL
  UNIVERSITY
  CORPORATE
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  hashedPassword String
  wisdomPoints   Int      @default(0)
  civilityScore  Int      @default(100)
  isPremium      Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  isBanned       Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  // Admin-granted bypass for the Circle creation paywall. Paid subscribers
  // are gated via Circle.subscriptionStatus instead.
  isGrantedCircleAccess Boolean @default(false)
  // Legacy per-user test-mode column. Kept for data preservation; no
  // longer consulted — test mode is now driven by SystemSetting.TEST_MODE
  // plus isAdmin. Drop in a future migration once we're sure nothing
  // references it.
  testMode       Boolean  @default(false)
  // Party Mode — single lifetime trial-minutes counter, shared across
  // Basic and Pro. Enforced server-side: if partyTrialMinutesUsed >= 60
  // and the user has no active subscription, the session-host endpoint
  // blocks with an upgrade prompt. A user can't trial Basic to 60, then
  // trial Pro separately — the clock is per-account, not per-tier.
  partyTrialMinutesUsed Int @default(0)
  // Party Pro entitlement. Populated by the Stripe webhook when a user
  // subscribes to either Party Basic or Party Pro; the session-host
  // endpoint checks partyProStatus="active" (or "trialing") to unlock
  // unlimited hosting. `partyProStripePriceLookupKey` records which tier
  // they're paying for (PARTY_BASIC_MONTHLY vs PARTY_PRO_MONTHLY) so
  // per-tier limits (8 vs 25 players, paradox pack access) can be
  // enforced at session-start. No Circle is minted for either tier —
  // these are user-level subscriptions.
  partyProStatus               String    @default("none")
  partyProStripeCustomerId     String?
  partyProStripeSubscriptionId String?   @unique
  partyProStripePriceLookupKey String?
  partyProCurrentPeriodEnd     DateTime?
  // System-owned accounts that play the AI sparring partner. Never able to
  // log in (random unusable password) and excluded from public listings.
  isBot          Boolean  @default(false)
  // Streak freezes bought with Wisdom Points. One is consumed per missed
  // day, automatically, the next time the user casts a vow.
  streakFreezes  Int      @default(0)
  // Set when the user finishes (or skips) the first-run practice round.
  onboardedAt    DateTime?
  // Set when the user confirms at registration that they are 13 or older
  // (or are joining through a school with a teacher's invite code).
  ageAttestedAt  DateTime?
  createdAt      DateTime @default(now())

  votes            Vote[]
  tribeHistory     TribeHistory[]
  duelsAsA         Duel[]         @relation("DuelUserA")
  duelsAsB         Duel[]         @relation("DuelUserB")
  throwbackRevotes ThrowbackRevote[]
  feedback         Feedback[]
  submittedParadoxes SubmittedParadox[]
  authoredParadoxes  Paradox[]          @relation("ParadoxSubmitter")
  ownedCircles       Circle[]           @relation("CircleOwner")
  circleMemberships  CircleMembership[]
  inviteCodesCreated CircleInviteCode[] @relation("InviteCreator")

  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]

  // Late-vow grants this user has received + grants this admin issued.
  // The `@relation` names keep both sides of the back-ref unambiguous.
  lateVowGrants       LateVowGrant[] @relation("LateVowGrantUser")
  lateVowGrantsIssued LateVowGrant[] @relation("LateVowGrantAdmin")
  // Global late-vow grants issued by this admin (audit back-ref).
  globalLateVowGrantsIssued GlobalLateVowGrant[] @relation("GlobalLateVowGrantAdmin")
  oracleMarks         OracleMark[]
  streakFreezeUses    StreakFreezeUse[]
  reportsFiled        DuelReport[] @relation("DuelReportReporter")
  reportsAgainst      DuelReport[] @relation("DuelReportReported")
}

// Admin-issued exemption that lets one user cast a vote on one paradox
// outside the usual vow window. Checked by POST /api/vote: if the user
// has an unused grant for the target paradox, the phase gate is bypassed
// and `usedAt` is stamped atomically with the vote. `(userId, paradoxId)`
// is unique so re-granting is idempotent — an admin clicking "grant"
// twice produces one row, and deleting restores the un-granted state.
// Cascade on user/paradox delete keeps the table clean; the admin
// back-ref is SetNull so we retain grant history if an admin account
// is ever removed.
model LateVowGrant {
  id                String    @id @default(cuid())
  userId            String
  paradoxId         String
  grantedByAdminId  String?
  createdAt         DateTime  @default(now())
  usedAt            DateTime?

  user            User    @relation("LateVowGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  paradox         Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)
  grantedByAdmin  User?   @relation("LateVowGrantAdmin", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([userId, paradoxId])
  @@index([paradoxId])
  @@index([grantedByAdminId])
}

// Admin-issued exemption that opens the vow window for **every** user on
// one paradox. Unlike LateVowGrant (per-user, one-shot), a global grant
// is consulted on every vote during its lifetime — it does not burn on
// use. `isActive` is the operative flag; `revokedAt` timestamps when an
// admin turned it off. Multiple rows per paradox are allowed (so the
// history of grant/revoke cycles is preserved); the vote route checks for
// ANY row with `isActive = true` for today's paradox.
model GlobalLateVowGrant {
  id                String    @id @default(cuid())
  paradoxId         String
  grantedByAdminId  String?
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  isActive          Boolean   @default(true)

  paradox        Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)
  grantedByAdmin User?   @relation("GlobalLateVowGrantAdmin", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@index([paradoxId, isActive])
  @@index([grantedByAdminId])
}

// Web Push (browser Push API) subscriptions. One row per browser-device
// that has opted in. `endpoint` is the push service URL returned by the
// browser — unique per subscription, so it doubles as the dedupe key.
// `p256dh` and `auth` are the VAPID encryption keys; both are required
// for sendNotification. Stale subscriptions (410 from the push service)
// are pruned by the notification scheduler on send failure.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Generic key/value table for operator-togglable runtime settings. Today
// it holds a single row: `TEST_MODE` (value = "true" | "false"), which the
// admin Developer panel flips. Extensible to any flag that should change
// without a redeploy. Values are stored as strings — callers parse per
// setting (e.g. boolean-from-string for TEST_MODE).
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Single-use password reset tokens. `token` is a random hex string
// (crypto.randomBytes(32).toString("hex")) stored plainly — it's already
// high-entropy and expires within an hour; treat it like a session token,
// not a password. `usedAt` flips on successful reset so replay fails.
// Cascade on user delete keeps the table clean.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Paradox {
  id          String   @id @default(cuid())
  title       String
  description String
  optionA     String
  optionB     String
  category    String
  // Each paradox airs on exactly one date. Null = not yet scheduled.
  airDate     DateTime? @unique @db.Date
  createdAt   DateTime  @default(now())
  // Null for seed/editorial paradoxes; populated when an admin approves
  // a user-submitted dilemma. Nulling the user would orphan their credit
  // rather than deleting the paradox, so onDelete:SetNull.
  submittedById String?
  submittedBy   User?    @relation("ParadoxSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  votes            Vote[]
  duels            Duel[]
  tribeHistory     TribeHistory[]
  throwbackRevotes ThrowbackRevote[]
  lateVowGrants    LateVowGrant[]
  globalLateVowGrants GlobalLateVowGrant[]

  @@index([submittedById])
}

model Vote {
  id            String   @id @default(cuid())
  userId        String
  paradoxId     String
  choice        Choice
  justification String
  // Populated by Phase III. Null until Oracle has sorted.
  tribeAssigned Tribe?
  tribeConfidence Float?
  tribeReasoning String?
  createdAt     DateTime @default(now())
  sortedAt      DateTime?
  // True when the vow was cast after the Vow window closed (self-serve late
  // vow). Late vows are sorted immediately and still count for streaks.
  isLate        Boolean  @default(false)
  // Scopes a vote to a private circle game. Null = global/public game.
  // Runtime routing by circle game is not wired yet — see Circles rollout notes.
  circleGameId  String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paradox    Paradox     @relation(fields: [paradoxId], references: [id], onDelete: Cascade)
  circleGame CircleGame? @relation(fields: [circleGameId], references: [id], onDelete: SetNull)

  throwbackRevote ThrowbackRevote?

  @@unique([userId, paradoxId])
  @@index([paradoxId, choice])
  @@index([paradoxId, tribeAssigned])
  @@index([circleGameId])
}

// Thursday revisits. Every Thursday, eligible users revote a prior
// Thursday paradox (≥28 days old). Original Vote stays untouched; the
// revisit lives here so both points in time are preserved.
model ThrowbackRevote {
  id               String   @id @default(cuid())
  userId           String
  originalVoteId   String   @unique
  paradoxId        String
  newChoice        Choice
  newJustification String
  // "shifted" | "held" | "evolved" — see lib/throwback.ts
  shift            String
  createdAt        DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalVote Vote    @relation(fields: [originalVoteId], references: [id], onDelete: Cascade)
  paradox      Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Denormalized tribe history for fast profile queries + Moral Constellation.
// One row per (user, paradox) — duplicates Vote.tribeAssigned but indexed for
// timeline scans.
model TribeHistory {
  id        String   @id @default(cuid())
  userId    String
  paradoxId String
  tribe     Tribe
  airDate   DateTime @db.Date
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paradox Paradox @relation(fields: [paradoxId], references: [id], onDelete: Cascade)

  @@unique([userId, paradoxId])
  @@index([userId, airDate])
}

// Phase IV — populated next session. Declared now so migrations stay additive.
model Duel {
  id                   String   @id @default(cuid())
  paradoxId            String
  userAId              String
  userBId              String
  transcriptJson       Json     @default("[]")
  synthesisText        String?
  synthesisGeneratedAt DateTime?
  signedByAAt          DateTime?
  signedByBAt          DateTime?
  declinedAt           DateTime?
  bothSigned           Boolean  @default(false)
  // "pvp" (two humans), "spar" (human vs the AI sparring partner) or
  // "practice" (first-run tutorial spar — no score changes).
  kind                 String   @default("pvp")
  // Live-state checkpoint (participants, acknowledgements, extension
  // requests, awarded marks). Written on every state change so a server
  // restart can rebuild in-flight duels — see sockets/duelRecovery.ts.
  stateJson            Json     @default("{}")
  startedAt            DateTime @default(now())
  endedAt              DateTime?
  // Scopes a duel to a private circle game. Null = global/public game.
  circleGameId         String?

  paradox    Paradox     @relation(fields: [paradoxId], references: [id])
  userA      User        @relation("DuelUserA", fields: [userAId], references: [id])
  userB      User        @relation("DuelUserB", fields: [userBId], references: [id])
  circleGame CircleGame? @relation(fields: [circleGameId], references: [id], onDelete: SetNull)

  archive SynthesisArchive?
  marks   OracleMark[]
  reports DuelReport[]

  @@index([paradoxId])
  @@index([bothSigned])
  @@index([circleGameId])
}

// Minimal stub for the Private Circles application form. Stored so ops has
// a record to follow up on; no admin UI yet.
model CircleApplication {
  id           String   @id @default(cuid())
  organization String
  kind         String   // "JUNIOR_HIGH" | "HIGH_SCHOOL" | "UNIVERSITY" | "COMPANY"
  contactEmail String
  note         String?
  submittedByUserId String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// User-submitted feedback (bug reports, feature requests, general notes).
// Visible to admins in the admin panel.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   // "bug" | "feature" | "general"
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// User-submitted paradox proposals. Admins approve/reject in the admin panel.
// On approval, a Paradox is created and scheduled to the next free airDate.
model SubmittedParadox {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  optionA     String
  optionB     String
  category    String
  reason      String
  status      SubmittedParadoxStatus @default(pending)
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  scheduledFor DateTime? @db.Date
  paradoxId   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Phase V — public archive of signed syntheses.
model SynthesisArchive {
  id            String   @id @default(cuid())
  duelId        String   @unique
  paradoxTitle  String
  tribeA        Tribe
  tribeB        Tribe
  synthesisText String
  signedAt      DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([signedAt])
}

// Private Circles — closed instances for schools, universities, and companies.
// A Circle holds one or more CircleGames (e.g. "Period 1 Class"). Membership
// is per-Circle, not per-Game — members are invited into a Circle and can
// participate in any Game within it. Stripe fields (customerId, subscriptionId,
// seatLimit, billingPeriod, currentPeriodEnd) will be added in the Stripe pass.
model Circle {
  id                 String   @id @default(cuid())
  name               String
  type               CircleType
  ownerId            String
  // Stripe lifecycle. "trial" (or "pending") until the checkout.session.completed
  // webhook flips it to "active". "past_due" on invoice.payment_failed;
  // "canceled" on subscription.deleted.
  subscriptionStatus String   @default("trial")
  stripeCustomerId      String?
  stripeSubscriptionId  String?  @unique
  // Stable key from the server pricing catalogue, e.g. JR_HIGH_STANDARD_MONTHLY.
  // Lets us render the plan name + intent without round-tripping Stripe.
  stripePriceLookupKey  String?
  // "monthly" | "6month" | "annual". Mirrors the catalogue billing choice.
  billingPeriod         String?
  // Null = unlimited (CORPORATE_ENTERPRISE tier).
  seatLimit             Int?
  currentPeriodEnd      DateTime?
  // Reserved for per-Circle defaults (e.g. default schedule overrides).
  settings           Json     @default("{}")
  createdAt          DateTime @default(now())

  owner       User               @relation("CircleOwner", fields: [ownerId], references: [id])
  memberships CircleMembership[]
  games       CircleGame[]

  @@index([ownerId])
  @@index([stripeCustomerId])
}

model CircleMembership {
  id       String         @id @default(cuid())
  circleId String
  userId   String
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// One daily loop inside a Circle. Multiple Games per Circle lets a teacher
// run separate classes on separate paradoxes. Per-game schedule fields are
// stored now but runtime resolution is still global — wired in a later pass.
model CircleGame {
  id             String         @id @default(cuid())
  circleId       String
  name           String
  description    String?
  paradoxPackage ParadoxPackage @default(STANDARD)
  dropHour       Int            @default(8)
  vowEndHour     Int            @default(12)
  sortEndHour    Int            @default(20)
  duelHour       Int            @default(20)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  circle      Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviteCodes CircleInviteCode[]
  votes       Vote[]
  duels       Duel[]

  @@index([circleId])
}

// Short, shareable codes that consume into a CircleMembership on the parent
// Circle. A code belongs to a Game so the join confirmation can show which
// class/department the user is joining.
model CircleInviteCode {
  id           String    @id @default(cuid())
  circleGameId String
  code         String    @unique
  uses         Int       @default(0)
  maxUses      Int?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  createdById  String

  circleGame CircleGame @relation(fields: [circleGameId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([circleGameId])
}

// Age/role-targeted dilemma packs. STANDARD is intentionally not stored here
// (Games with package=STANDARD draw from the global Paradox table). The
// paradoxes column is a JSON array of { title, description, optionA, optionB,
// category } objects — light-weight, non-normalized since packs are content,
// not user data.
model CircleParadoxPack {
  id        String         @id @default(cuid())
  package   ParadoxPackage @unique
  paradoxes Json
  updatedAt DateTime       @updatedAt
}

// One row per Gold Star / Red Flag the Oracle awards during a duel's
// Crucible. Drives WP, badges, Tribe Wars and the public highlights feed.
// `isPublic` is false for duels involving school-circle (minor) accounts —
// those messages never appear in public highlights.
model OracleMark {
  id          String   @id @default(cuid())
  userId      String
  duelId      String
  paradoxId   String
  kind        String   // "gold_star" | "red_flag"
  fallacyType String?
  tribe       Tribe
  messageText String
  explanation String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([createdAt, kind])
  @@index([paradoxId, kind])
}

// A streak freeze spent to cover one missed day.
model StreakFreezeUse {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Player-filed report against their duel opponent. Reviewed in the admin
// panel. `status` is "open" until an admin resolves it.
model DuelReport {
  id         String    @id @default(cuid())
  duelId     String
  reporterId String
  reportedId String
  reason     String    // "harassment" | "hate" | "sexual" | "spam" | "other"
  note       String?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  duel     Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  reporter User @relation("DuelReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("DuelReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reportedId])
}
